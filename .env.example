# Public
NEXT_PUBLIC_SITE_URL=https://media-chief.com

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=contact@media-chief.com
FROM_EMAIL=noreply@media-chief.com

# Stripe (card payments)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Database (Railway Postgres)
DATABASE_URL=postgres://user:pass@host:port/db

# NextAuth v5 (client account)
# Generate: openssl rand -base64 32
AUTH_SECRET=change_me_to_random_32_chars_min
AUTH_URL=https://media-chief.com

# Admin auth (admin panel, separate from the client account)
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_in_production
SESSION_SECRET=change_me_to_a_long_random_string_min_32_chars

# Meta Pixel + Conversions API (Facebook Ads landing page /offer-fb)
NEXT_PUBLIC_META_PIXEL_ID=1234567890
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# Google Analytics 4 + Google Ads (one gtag.js serves both)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
