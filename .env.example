# Public
NEXT_PUBLIC_SITE_URL=https://mediaexpress.ro

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=contact@mediaexpress.ro
FROM_EMAIL=noreply@mediaexpress.ro

# Stripe (plati card + abonamente)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# Database (Railway Postgres)
DATABASE_URL=postgres://user:pass@host:port/db

# NextAuth v5 (cont client)
# Generate: openssl rand -base64 32
AUTH_SECRET=change_me_to_random_32_chars_min
AUTH_URL=https://mediaexpress.ro

# Admin auth (panel admin, separat de contul client)
ADMIN_USER=admin
ADMIN_PASSWORD=change_me_in_production
SESSION_SECRET=change_me_to_a_long_random_string_min_32_chars

# Cloudinary (upload poze articol — max 3/articol)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=mediaexpres

# Anthropic (generare articol AI)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-6

# Meta Pixel (Facebook Ads)
NEXT_PUBLIC_META_PIXEL_ID=1234567890

# Google Analytics 4 — raportare trafic
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Google Ads — ID cont + etichetele conversiilor.
# Etichetele se iau din Google Ads > Obiective > Conversii > actiunea creata,
# din tag-ul "send_to": 'AW-123456789/AbCdEfGhIjK' — partea de dupa slash.
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-123456789
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_ORDER_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
